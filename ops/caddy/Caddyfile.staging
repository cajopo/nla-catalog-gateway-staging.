{
    admin off
    log default {
        exclude http.log.access http.log.error
    }
    servers {
        protocols h1 h2
        strict_sni_host on
        max_header_size 16KB
        timeouts {
            read_header 10s
            read_body 15s
            write 30s
            idle 60s
        }
    }
}

# Alternate loopback ports: warm a replacement before retiring the old process.
# No public backend ports, admin API or per-refresh Caddy reload.
(nla_catalog_upstreams) {
    lb_policy first
    health_uri /readyz
    health_interval 2s
    health_timeout 1s
    health_status 200
    fail_duration 3s
    max_fails 1
    lb_try_duration 5s
    lb_try_interval 250ms
}

catalog-staging.nextlevelarena.it {
    @catalog {
        method POST
        vars_regexp {http.request.uri} ^/proxy/catalog/?([?].*)?$
    }
    handle @catalog {
        rewrite * /proxy/catalog
        request_body {
            max_size 64KB
        }
        reverse_proxy 127.0.0.1:10000 127.0.0.1:10001 {
            import nla_catalog_upstreams
            transport http {
                dial_timeout 3s
                response_header_timeout 20s
            }
        }
    }
    @health {
        method GET
        path /livez /readyz
    }
    handle @health {
        reverse_proxy 127.0.0.1:10000 127.0.0.1:10001 {
            import nla_catalog_upstreams
            transport http {
                dial_timeout 3s
                response_header_timeout 5s
            }
        }
    }
    handle {
        respond "Not found" 404
    }
}
